# Shared by the Next.js app and the worker (engine).
# Copy to .env and set GEMINI_API_KEY. Never commit .env.

# --- App + engine ---
# Local MongoDB and Redis. docker compose overrides these two with its own services.
MONGODB_URI=mongodb://localhost:27017/rowsmith
REDIS_URL=redis://localhost:6379
# From https://aistudio.google.com/apikey. Grounded search is billed per query.
GEMINI_API_KEY=
# Public base URL (absolute links in page metadata).
APP_URL=http://localhost:3000
# Minutes to research one value by hand (time-saved estimate). Measure it: fill 5 rows yourself.
DEFAULT_MINUTES_PER_FIELD=0.5

# --- Engine ---
# One model per role. Each must be in MODEL_CATALOG (engine/llm/models.ts),
# which holds its price and thinking levels.
# *_FALLBACKS: comma-separated models tried in order when the role's model
# answers 503 (overloaded). Each must be in MODEL_CATALOG too. Blank = none.
# Grounded search: picks queries, writes notes (per row).
MODEL_SEARCH=gemini-3.6-flash
MODEL_SEARCH_FALLBACKS=gemini-3.5-flash-lite
# Copies values and quotes from the notes (per row).
MODEL_EXTRACT=gemini-3.5-flash-lite
MODEL_EXTRACT_FALLBACKS=gemini-3.1-flash-lite
# Judges each value against its quote; also the last extraction retry (per row).
# The accuracy gate; its Lite fallback is weaker, used only on a 503.
MODEL_VERIFY=gemini-3.6-flash
MODEL_VERIFY_FALLBACKS=gemini-3.5-flash-lite
# Proposes the job setup (once per job, in the app; the user waits on it).
MODEL_SUGGEST=gemini-3.6-flash
MODEL_SUGGEST_FALLBACKS=gemini-3.5-flash-lite
# Eval-only grader; should be stronger than MODEL_SEARCH. No fallback.
MODEL_JUDGE=gemini-4-argon
ENRICH_CONCURRENCY=5
RATE_MAX=5
LOG_LEVEL=info
